{
  "name": "vendorflow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host localhost --proxy-config proxy.conf.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src",
    "demo:record": "playwright test --config=scripts/demo/config.ts",
    "gen:api": "node scripts/api-types.mjs",
    "prebuild": "node scripts/api-types.mjs --check",
    "postinstall": "npm ci --prefix scripts --no-audit --no-fund"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.0.0",
    "@playwright/test": "^1.0.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
